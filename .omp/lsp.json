{
  "servers": {
    "pyright": {
      "command": "pyright-langserver",
      "args": ["--stdio"],
      "fileTypes": [".py", ".pyi"],
      "rootMarkers": ["pyrightconfig.json", ".venv", ".git"],
      "settings": {
        "python": {
          "analysis": {
            "autoSearchPaths": true,
            "diagnosticMode": "openFilesOnly",
            "useLibraryCodeForTypes": true
          }
        }
      }
    },
    "ruff": {
      "command": "ruff",
      "args": ["server"],
      "fileTypes": [".py", ".pyi"],
      "rootMarkers": ["pyrightconfig.json", ".venv", ".git"],
      "isLinter": true
    }
  }
}
